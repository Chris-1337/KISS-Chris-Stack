{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'hooks/stack.js'))\"",
            "timeout": 15,
            "additionalContextLimit": 0,
            "statusMessage": "Checking KISS-Chris-Stack workflow..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\"",
            "timeout": 15,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'hooks/stack.js'))\"",
            "timeout": 15,
            "additionalContextLimit": 0,
            "statusMessage": "Checking KISS-Chris-Stack workflow..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\"",
            "timeout": 15,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'hooks/stack.js'))\"",
            "timeout": 15,
            "additionalContextLimit": 0,
            "statusMessage": "Checking KISS-Chris-Stack workflow..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CODEX_PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\"",
            "timeout": 15,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  }
}
